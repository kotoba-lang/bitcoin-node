{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.5"}
        io.github.kotoba-lang/json {:git/sha "b47b06486b3ad53051bc7d8bf361f4176f467202"}
        io.github.kotoba-lang/chain-observer
        {:git/url "https://github.com/kotoba-lang/chain-observer.git"
         :git/tag "v0.1.0"
         :git/sha "f3fa15ae68dd3ec33ffb90917a74a0f1dbde8699"}
        io.github.kotoba-lang/bitcoin-consensus
        {:git/url "https://github.com/kotoba-lang/bitcoin-consensus.git"
         :git/tag "v0.38.0"
         :git/sha "11150163ab47810ed014f13855256fd1e5ac415f"}
        io.github.kotoba-lang/sha256d
        {:git/url "https://github.com/kotoba-lang/sha256d.git"
         :git/sha "5fd4e64d0fc5a616b798edbca7327da33c78eb02"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo
                        {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}
  :coverage
  {:extra-paths ["test"]
   :extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}}
   :main-opts ["-m" "cloverage.coverage"
               "-p" "src" "-s" "test"
               "--no-html" "--text"
               "--fail-threshold" "70"]}
  :core-blockfilter-vectors
  {:extra-paths ["test"]
   :main-opts ["-m" "bitcoin.node.core-blockfilter-vectors"]}
  :fuzz
  {:extra-paths ["test"]
   :main-opts ["-m" "bitcoin.node.fuzz"]}
  :crash-test
  {:extra-paths ["test"]
   :main-opts ["-m" "bitcoin.node.crash"]}}}
